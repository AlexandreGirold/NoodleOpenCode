{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheGostsniperfr/Noodle/schemas/inventory/v1alpha1/inventory.schema.json",
  "title": "Noodle repository inventory",
  "type": "object",
  "required": ["apiVersion", "kind", "roots"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "noodle.inventory/v1alpha1"},
    "kind": {"const": "Inventory"},
    "roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/root"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "elements": {"type": "array", "items": {"$ref": "../../v1alpha1/fragment.schema.json#/$defs/element"}},
    "connections": {"type": "array", "items": {"$ref": "../../v1alpha1/fragment.schema.json#/$defs/connection"}},
    "references": {"type": "array", "items": {"$ref": "../../v1alpha1/fragment.schema.json#/$defs/reference"}},
    "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "src": {"$ref": "../../v1alpha1/fragment.schema.json#/$defs/src"},
    "root": {
      "type": "object", "required": ["id", "path"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}
    },
    "file": {
      "type": "object", "required": ["root", "path", "format", "status", "bytes"], "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "status": {"enum": ["extracted", "inventory-only", "render-required", "unresolved"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "package": {
      "type": "object", "required": ["ecosystem", "src"], "additionalProperties": false,
      "properties": {
        "ecosystem": {"enum": ["npm", "pypi"]}, "name": {"type": "string", "minLength": 1}, "src": {"$ref": "#/$defs/src"},
        "dependencies": {"type": "array", "items": {
          "type": "object", "required": ["name", "scope", "src"], "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "src": {"$ref": "#/$defs/src"}}
        }}
      }
    },
    "issue": {
      "type": "object", "required": ["format", "reason", "src"], "additionalProperties": false,
      "properties": {"format": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "src": {"$ref": "#/$defs/src"}}
    }
  }
}
